</section>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<noscript><p style="text-align:center;padding:40px">فعّل JavaScript عشان تقدر تطلب من الموقع.</p></noscript>

<script src="./config.js?v=20260924-11"></script>
<script src="./platform-store.js"></script>
<script type="module" src="./firebase-client.js"></script>
<script src="./images/products/list.js?v=20260924-11" onerror="void 0"></script>
<script>
'use strict';

/* ================== أدوات عامة ================== */
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt = n => Number(n).toLocaleString('en-US');
const normalize = s => String(s).toLowerCase().replace(/[\u064B-\u0652\u0640]/g,'').replace(/[أإآ]/g,'ا').replace(/ى/g,'ي').replace(/ة/g,'ه');
const toLatinDigits = s => s.replace(/[٠-٩]/g, d => '٠١٢٣٤٥٦٧٨٩'.indexOf(d));

let remoteOffers = [];
let byId = new Map(PRODUCTS.map(p => [p.id, p]));
const catMap = new Map(CATEGORIES.map(c => [c[0], { key:c[0], label:c[1], emoji:c[2], group:c[3], color:c[4] }]));
const hasPrice = p => typeof p.price === 'number' && p.price > 0;
const isPharma = p => catMap.get(p.cat)?.group === 'pharmacy';

const state = { cart:{}, special:'', customer:{name:'',phone:'',address:'',note:''}, group:'all', cat:'all', query:'' };

function loadState(){
  try{
    const s = JSON.parse(localStorage.getItem(CONFIG.storageKey) || '{}');
    if (s.cart && typeof s.cart === 'object')
      for (const [id,q] of Object.entries(s.cart)){ const n = Math.min(99, parseInt(q,10)); if (byId.has(id) && n>0) state.cart[id]=n; }
    if (typeof s.special === 'string') state.special = s.special.slice(0,300);
    if (s.customer) for (const k of ['name','phone','address','note']) if (typeof s.customer[k] === 'string') state.customer[k] = s.customer[k];
  }catch(e){}
}
function saveState(){
  try{ localStorage.setItem(CONFIG.storageKey, JSON.stringify({cart:state.cart, special:state.special, customer:state.customer})); }catch(e){}
}

/* ---------- حسابات السلة ---------- */
const subtotal = () => Object.entries(state.cart).reduce((s,[id,q]) => s + (hasPrice(byId.get(id)) ? byId.get(id).price*q : 0), 0);
const itemCount = () => Object.values(state.cart).reduce((a,b)=>a+b,0);
const hasSpecial = () => state.special.trim() !== '';
const hasOrder = () => itemCount() > 0 || hasSpecial();
const hasPharma = () => Object.keys(state.cart).some(id => isPharma(byId.get(id)));
function deliveryFee(){
  if (!hasOrder()) return 0;
  return (CONFIG.freeDelivery && subtotal() >= CONFIG.freeDelivery) ? 0 : CONFIG.deliveryFee;
}

let toastTimer;
function toast(msg){ const t=$('#toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(toastTimer); toastTimer=setTimeout(()=>t.classList.remove('show'),1900); }

/* ================== حالة المتجر (مفتوح/مغلق) ================== */
function cairoHour(){
  const parts = new Intl.DateTimeFormat('en-GB',{timeZone:'Africa/Cairo',hour:'numeric',minute:'numeric',hour12:false}).formatToParts(new Date());
  return Number(parts.find(p=>p.type==='hour').value) + Number(parts.find(p=>p.type==='minute').value)/60;
}
const hh = h => { h = h % 24; const suf = h >= 12 ? 'م' : 'ص'; return ((h % 12) || 12) + ' ' + suf; };
function isOpen(){ let h = cairoHour(); if (h < CONFIG.openHour && CONFIG.closeHour > 24) h += 24; return h >= CONFIG.openHour && h < CONFIG.closeHour; }
function renderStatus(){
  const el = $('#status'), open = isOpen();
  el.className = 'status ' + (open ? 'open' : 'closed');
  el.textContent = open ? 'مفتوح الآن' : 'يفتح ' + hh(CONFIG.openHour);
}

/* ================== الصور والمنتجات ================== */
function picHTML(p){
  const c = catMap.get(p.cat);
  const have = !window.IMAGE_IDS || window.IMAGE_IDS.includes(p.id);   // list.js بيحدد الصور الموجودة فعلًا (يمنع 404)
  const src = p.img || (CONFIG.autoImages && have ? `${CONFIG.imageDir}${p.id}.webp?v=${CONFIG.imageVersion}` : '');
  const img = src ? `<img src="${esc(src)}" alt="${esc(p.name)}" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()">` : '';
  let badge = '';
  if (p.oldPrice && p.oldPrice > p.price) badge = `<span class="badge${isPharma(p)?' pharma':''}">-${Math.round((1 - p.price/p.oldPrice)*100)}%</span>`;
  else if (p.badge) badge = `<span class="badge${isPharma(p)?' pharma':''}">${esc(p.badge)}</span>`;
  return `<div class="pic" style="background:${c.color}">${badge}<span aria-hidden="true">${p.emoji || c.emoji}</span>${img}</div>`;
}
function actionHTML(id){
  const p = byId.get(id);
  if (p.soldOut) return '<button class="add" disabled>نفد</button>';
  const q = state.cart[id] || 0;
  if (!q) return `<button class="add" data-act="inc" data-id="${esc(id)}" aria-label="أضف ${esc(p.name)}">+</button>`;
  return `<div class="step"><button data-act="inc" data-id="${esc(id)}" aria-label="زيادة">+</button><output>${q}</output><button data-act="dec" data-id="${esc(id)}" aria-label="تقليل">−</button></div>`;
}
function cardHTML(p){
  return `<article class="card${p.soldOut?' sold':''}">
    ${picHTML(p)}
    <h3>${esc(p.name)}</h3>
    <div class="card-foot">
      <div class="price">${hasPrice(p) ? fmt(p.price) + ' <small>ج.م</small>' : '<small>السعر عند التأكيد</small>'}${p.oldPrice && p.oldPrice>p.price ? `<s>${fmt(p.oldPrice)} ج.م</s>` : ''}</div>
      <div class="card-action" data-id="${esc(p.id)}">${actionHTML(p.id)}</div>
    </div>
  </article>`;
}

/* ================== العرض الرئيسي ================== */
const inGroup = p => state.group === 'all' || catMap.get(p.cat).group === state.group;
const visible = p => (!CONFIG.hideUnpriced || hasPrice(p)) && inGroup(p);

function renderTiles(){
  const cats = CATEGORIES.filter(c => state.group === 'all' || c[3] === state.group);
  $('#tiles').innerHTML = cats.map(c => `<button class="tile" data-cat="${esc(c[0])}" aria-pressed="${state.cat===c[0]}" style="background:${c[4]}"><span class="em">${c[2]}</span>${esc(c[1])}</button>`).join('');
}

function section(title, list, opts={}){
  if (!list.length) return '';
  const head = `<div class="sec-head"><h2>${title}${opts.timer ? ' <span class="timer" id="timer"></span>' : ''}</h2>${opts.cat ? `<button class="more" data-cat="${esc(opts.cat)}">عرض الكل ‹</button>` : ''}</div>`;
  return `<section class="sec" ${opts.id ? `id="${opts.id}"`:''}>${head}${opts.row ? `<div class="hrow">${list.map(cardHTML).join('')}</div>` : `<div class="grid">${list.map(cardHTML).join('')}</div>`}</section>`;
}

function renderContent(){
  const q = normalize(state.query.trim());
  $('#searchBox').classList.toggle('has', !!state.query);
  $('#palBanner').style.display = $('#hero').style.display = $('.usp').style.display = $('#catSec').style.display = (q ? 'none' : '');
  let html = '';

  if (q){
    const list = PRODUCTS.filter(p => visible(p) && (normalize(p.name).includes(q) || normalize(catMap.get(p.cat).label).includes(q)));
    const bm = boycottMatch(state.query);
    const bnote = bm ? `<div class="bmsg">🕊️ <b>«${esc(state.query)}»</b> من علامات <b>${esc(bm.group)}</b> المشمولة بالمقاطعة — مش بنبيعها ومش بنوصّلها. جرّب البدائل المتاحة تحت، أو <a href="./boycott.html">اعرف القائمة والمصادر</a>.</div>` : '';
    html = bnote + `<div class="sec"><div class="sec-head"><h2>🔎 نتائج «${esc(state.query)}» (${list.length})</h2></div><div class="grid">${list.length ? list.map(cardHTML).join('') : '<p class="empty"><span>🔍</span>مش لاقيين نفس الاسم دلوقتي.<br>جرّب كلمة تانية أو ابعت لنا «طلب خاص».</p>'}</div></div>`;
  } else if (state.cat !== 'all'){
    const c = catMap.get(state.cat);
    html = `<div class="crumb"><button class="chip" data-cat="all">✕ ${c.emoji} ${esc(c.label)}</button></div>` +
      section('', PRODUCTS.filter(p => p.cat === state.cat && visible(p)));
  } else {
    const deals = PRODUCTS.filter(p => visible(p) && p.oldPrice > p.price);
    const best = PRODUCTS.filter(p => visible(p) && p.badge === 'الأكثر طلبًا');
    // العروض ظهرت فوق الصفحة داخل #featuredOffers بدل تكرارها هنا.
    html += section('⭐ الناس بتطلب إيه؟', best, {row:true});
    CATEGORIES.filter(c => state.group === 'all' || c[3] === state.group).forEach(c => {
      html += section(`${c[2]} ${esc(c[1])}`, PRODUCTS.filter(p => p.cat === c[0] && visible(p)), {row:true, cat:c[0]});
    });
  }
  $('#content').innerHTML = html;
  updateTimer();
}

function refreshCards(id){
  document.querySelectorAll(`.card-action[data-id="${CSS.escape(id)}"]`).forEach(h => h.innerHTML = actionHTML(id));
}

/* ================== عدّاد العروض ================== */
function updateTimer(){
  const el = $('#timer'); if (!el) return;
  const n = new Date(); const end = new Date(n); end.setHours(24,0,0,0);
  let s = Math.max(0, Math.floor((end - n)/1000));
  const p = v => String(v).padStart(2,'0');
  el.innerHTML = `<b>${p(Math.floor(s/3600))}</b>:<b>${p(Math.floor(s%3600/60))}</b>:<b>${p(s%60)}</b>`;
}
setInterval(updateTimer, 1000);

/* ================== البانر ================== */
let slideIdx = 0, slideTimer;
function renderHero(){
  $('#slides').innerHTML = BANNERS.map((b,i) => `<div class="slide" style="background:${b.bg}" data-go="${i}"><div><h2>${esc(b.title)}</h2><p>${esc(b.sub)}</p><button class="cta" data-slide="${i}">${esc(b.cta)}</button></div><div class="art" aria-hidden="true">${b.emoji}</div></div>`).join('');
  $('#dots').innerHTML = BANNERS.map((_,i) => `<button data-dot="${i}" aria-label="شريحة ${i+1}" aria-current="${i===0}"></button>`).join('');
  startSlides();
}
function showSlide(i){
  slideIdx = (i + BANNERS.length) % BANNERS.length;
  $('#slides').style.transform = `translateX(${slideIdx*100}%)`;   // RTL: الاتجاه موجب
  $$('#dots button').forEach((d,k) => d.setAttribute('aria-current', k===slideIdx));
}
function startSlides(){
  clearInterval(slideTimer);
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  slideTimer = setInterval(() => showSlide(slideIdx+1), 4500);
}
function goBanner(i){
  const g = BANNERS[i].go || {};
  if (g.href){ location.href = g.href; return; }
  if (g.group) setGroup(g.group);
  if (g.cat){ setGroup('all'); setCat(g.cat); }
  if (g.deals){ setGroup('all'); setCat('all'); scrollTo($('#featuredOffers')); }
  if (g.group || g.cat) scrollTo($('#content'));
}
function scrollTo(el){ if (el) el.scrollIntoView({behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block:'start'}); }

/* ================== الفلاتر ================== */
function setGroup(g){
  state.group = g; state.cat = 'all';
  $$('.tab').forEach(t => t.setAttribute('aria-pressed', t.dataset.group === g));
  renderTiles(); renderContent();
}
function setCat(c){
  state.cat = c; renderTiles(); renderContent();
  if (c !== 'all') scrollTo($('#content'));
}

/* ================== السلة ================== */
function setQty(id, qty){
  const prev = state.cart[id] || 0;
  qty = Math.max(0, Math.min(99, qty));
  if (qty) state.cart[id] = qty; else delete state.cart[id];
  saveState(); refreshCards(id); renderCart();
  if (qty > prev){
    const b = $('#openCart'); b.classList.remove('bump'); void b.offsetWidth; b.classList.add('bump');
    if (!prev && isPharma(byId.get(id)) && !sessionStorageGet('pharmaSeen')){ toast('💊 المنتجات الصيدلانية بتتأكد مع الصيدلي قبل التسليم'); sessionStorageSet('pharmaSeen','1'); }
  }
}
function sessionStorageGet(k){ try{ return sessionStorage.getItem(k); }catch(e){ return null; } }
function sessionStorageSet(k,v){ try{ sessionStorage.setItem(k,v); }catch(e){} }

function renderCart(){
  const ids = Object.keys(state.cart);
  let html = ids.map(id => {
    const p = byId.get(id), q = state.cart[id], c = catMap.get(p.cat);
    const thContent = p.img ? `<img src="${esc(p.img)}" alt="${esc(p.name)}">` : (p.emoji || c.emoji);
    return `<div class="line">
      <div class="th" style="background:${c.color}">${thContent}</div>
      <span class="nm">${esc(p.name)}</span>
      <span class="tt">${hasPrice(p) ? fmt(p.price*q) + ' ج.م' : 'بالتأكيد'}</span>
      <div class="ctrl">
        <div class="step"><button data-act="inc" data-id="${esc(id)}" aria-label="زيادة">+</button><output>${q}</output><button data-act="dec" data-id="${esc(id)}" aria-label="تقليل">−</button></div>
        <span>${hasPrice(p) ? fmt(p.price) + ' ج.م للقطعة' : ''}</span>
        <button class="link" data-act="remove" data-id="${esc(id)}">حذف</button>
      </div></div>`;
  }).join('');
  if (hasSpecial()) html += `<div class="sp-line"><strong>📝 طلب خاص</strong><p>${esc(state.special)}</p><button class="link n" data-act="edit-special">تعديل</button> <button class="link" data-act="clear-special">حذف</button></div>`;
  if (!html) html = '<p class="empty" style="padding:30px 10px"><span>🛒</span>السلة فاضية.<br>ضيف منتجات وابدأ طلبك.</p>';
  $('#cartItems').innerHTML = html;

  const sub = subtotal(), fee = deliveryFee();
  $('#itemsTotal').textContent = fmt(sub);
  $('#deliveryFee').innerHTML = !hasOrder() ? '0 ج.م' : (fee === 0 ? '<span class="ok">مجاني 🎉</span>' : `<b>${fmt(fee)}</b> ج.م`);
  $('#finalTotal').textContent = fmt(sub + fee);
  $('#billNote').hidden = !hasSpecial();
  $('#pharmaNote').hidden = !hasPharma();
  $('#cartCount').textContent = itemCount();
  $('#cartCount').classList.toggle('show', itemCount() > 0);
  $('#sendOrder').disabled = !hasOrder();
  $('#addSpecialBtn').style.display = hasSpecial() ? 'none' : '';

  // شريط التوصيل المجاني
  const fr = $('#free');
  if (CONFIG.freeDelivery && hasOrder()){
    fr.style.display = '';
    const left = CONFIG.freeDelivery - sub;
    fr.classList.toggle('done', left <= 0);
    fr.innerHTML = (left <= 0 ? '🎉 التوصيل عليك مجاني!' : `🛵 ضيف ${fmt(left)} ج.م كمان واحصل على توصيل مجاني`) + `<div class="meter"><i style="width:${Math.min(100, sub/CONFIG.freeDelivery*100)}%"></i></div>`;
  } else fr.style.display = 'none';

  // شريط السلة السفلي
  const bar = $('#cartBar');
  bar.classList.toggle('show', hasOrder());
  $('#barCount').textContent = itemCount() + (hasSpecial() ? '+' : '');
  $('#barTotal').textContent = fmt(sub) + ' ج.م';
}

/* ================== اللوحات ================== */
const panels = ['cartPanel','specialPanel','helpPanel','installPanel','accountPanel','notificationsPanel'];
let lastFocus = null;
function openPanel(id){
  closeAll(true); lastFocus = document.activeElement;
  $('#'+id).classList.add('open'); $('#overlay').classList.add('open'); document.body.classList.add('lock');
  const t = $('#'+id).querySelector('textarea, [data-close]'); setTimeout(() => t && t.focus(), 60);
}
function closeAll(keep){
  panels.forEach(id => $('#'+id).classList.remove('open'));
  $('#overlay').classList.remove('open'); document.body.classList.remove('lock');
  if (!keep && lastFocus){ lastFocus.focus(); lastFocus = null; }
}
function openSpecial(){ $('#specialErr').textContent = ''; $('#specialText').value = state.special; updateSpecialCount(); openPanel('specialPanel'); }
function updateSpecialCount(){ $('#specialCount').textContent = $('#specialText').value.length; }

/* ================== إرسال الطلب ================== */
const showError = m => $('#formError').textContent = m;
let currentGpsCoords = null;
let currentAddressLabel = 'السكن';

// Reverse Geocode or humanize GPS location
async function reverseGeocodeCairo(lat, lng) {
  try {
    const res = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json&accept-language=ar`, { headers: { 'User-Agent': 'AlazharDelivery/2.0' } });
    if (res.ok) {
      const data = await res.json();
      if (data && data.display_name) {
        return data.display_name.split(',').slice(0, 3).join(' - ');
      }
    }
  } catch (_) {}
  return `موقع GPS (${lat.toFixed(4)}, ${lng.toFixed(4)}) - الحي السادس، مدينة نصر`;
}

function getDeviceGpsCoords() {
  return new Promise((resolve, reject) => {
    if (!navigator.geolocation) {
      return reject(new Error('خاصية تحديد الموقع الجغرافي (GPS) غير مدعومة في متصفحك.'));
    }
    navigator.geolocation.getCurrentPosition(
      async pos => {
        try {
          const lat = pos.coords.latitude;
          const lng = pos.coords.longitude;
          currentGpsCoords = { lat, lng };
          const address = await reverseGeocodeCairo(lat, lng);
          resolve({ lat, lng, address });
        } catch (e) {
          resolve({
            lat: pos.coords.latitude,
            lng: pos.coords.longitude,
            address: `موقع GPS (${pos.coords.latitude.toFixed(4)}, ${pos.coords.longitude.toFixed(4)}) - الحي السادس، مدينة نصر`
          });
        }
      },
      err => {
        let msg = 'تعذر الحصول على الموقع';
        if (err.code === 1) msg = 'يرجى السماح بصلاحية الموقع (GPS) في المتصفح لتحديد موقع السكن فوراً وقت الطلب.';
        else if (err.code === 2) msg = 'تعذر التقاط إشارة الأقمار الصناعية GPS.';
        else if (err.code === 3) msg = 'انتهت مهلة البحث عن الموقع.';
        reject(new Error(msg));
      },
      { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 }
    );
  });
}

function buildMessage(name, phone, address, note, lat, lng, addressLabel){
  const sub = subtotal(), fee = deliveryFee(), total = sub + fee;
  const labelText = addressLabel ? ` (${addressLabel})` : ' (السكن)';
  const L = [
    `*طلب جديد - ${CONFIG.brand}*`,
    '',
    `👤 العميل: ${name}`,
    `📞 الموبايل: ${phone}`,
    `Location المنطقة: ${CONFIG.area}`,
    `🏠 العنوان: ${address}${labelText}`
  ];
  if (lat && lng) {
    L.push(`🗺️ لوكيشن GPS مباشر للمندوب: https://maps.google.com/?q=${lat},${lng}`);
  }
  if (note) L.push(`💬 ملاحظات: ${note}`);
  L.push('');
  const groups = [['market','🛒 سوبرماركت:'],['pharmacy','💊 صيدلية:']];
  groups.forEach(([g,title]) => {
    const ids = Object.keys(state.cart).filter(id => catMap.get(byId.get(id).cat).group === g);
    if (!ids.length) return;
    L.push(title);
    ids.forEach(id => {
      const p = byId.get(id), q = state.cart[id];
      L.push(hasPrice(p) ? `• ${p.name} × ${q} = ${p.price*q} ج.م` : `• ${p.name} × ${q} (السعر بالتأكيد)`);
    });
    L.push('');
  });
  if (hasSpecial()) L.push('📝 طلب خاص:', state.special.trim(), '');
  L.push(
    `🧾 ثمن المنتجات: ${sub} ج.م`,
    `🚚 التوصيل: ${fee ? fee + ' ج.م' : 'مجاني'}`,
    `💰 الإجمالي: ${total} ج.م` + (hasSpecial() ? ' (+ الطلب الخاص)' : ''),
    '💵 الدفع: كاش عند الاستلام'
  );
  if (hasPharma()) L.push('', '⚕️ الطلب فيه منتجات صيدلانية — برجاء تأكيد الصيدلي.');
  return L.join('\n');
}

async function sendOrder(){
  showError('');
  const name = $('#clientName').value.trim();
  const phone = toLatinDigits($('#clientPhone').value).replace(/[\s-]/g,'');
  let address = $('#clientLocation').value.trim();
  const note = $('#clientNote').value.trim();
  const isGpsSelected = $('#locTypeGps') ? $('#locTypeGps').checked : true;
  const sendBtn = $('#sendOrder');
  const btnTextEl = $('#sendOrderBtnText');
  const btnIconEl = $('#sendOrderBtnIcon');

  if (!hasOrder()) return showError('السلة فاضية.');
  const bm = boycottMatch(state.special) || boycottMatch(note);
  if (bm) return showError(`🕊️ الطلب فيه «${bm.group}» — مش بنوفّر ولا بنوصّل منتجات الشركات المقاطعة. عدّل الطلب الخاص/الملاحظات.`);
  if (name.length < 3) return showError('اكتب الاسم بالكامل.');
  if (!/^(\+?20|0)?1[0125]\d{8}$/.test(phone)) return showError('رقم الموبايل غير صحيح. مثال: 01012345678');
  if (CONFIG.minOrder && subtotal() < CONFIG.minOrder && !hasSpecial()) return showError(`أقل قيمة للطلب ${CONFIG.minOrder} ج.م.`);

  let lat = state.customer?.lat || currentGpsCoords?.lat || null;
  let lng = state.customer?.lng || currentGpsCoords?.lng || null;
  let label = currentAddressLabel || 'السكن';

  // تحديد الموقع وقت الطلب تلقائياً إذا كان خيار GPS مفعلاً أو إذا لم يكتب العميل عنوان
  if (isGpsSelected || !address || address.length < 3) {
    if (btnTextEl) btnTextEl.textContent = 'جاري تحديد موقعك بالـ GPS وقت الطلب...';
    if (btnIconEl) btnIconEl.textContent = '⏳';
    sendBtn.disabled = true;
    $('#cartGpsStatus').textContent = '🛰️ جاري التقاط إحداثيات السكن بالقمر الصناعي الآن...';

    try {
      const gpsRes = await getDeviceGpsCoords();
      lat = gpsRes.lat;
      lng = gpsRes.lng;
      address = gpsRes.address;
      $('#clientLocation').value = address;
      $('#cartGpsStatus').textContent = `✅ تم التقاط موقع ${label}: ${address}`;
    } catch (err) {
      if (btnTextEl) btnTextEl.textContent = 'تحديد موقعي (GPS) وإرسال الطلب الآن';
      if (btnIconEl) btnIconEl.textContent = '🛵';
      sendBtn.disabled = false;
      if (!address || address.length < 3) {
        return showError(err.message || 'تعذر تحديد الموقع تلقائياً، يرجى كتابة العنوان أو تفعيل الـ GPS في هاتفك.');
      }
    } finally {
      if (btnTextEl) btnTextEl.textContent = 'تحديد موقعي (GPS) وإرسال الطلب الآن';
      if (btnIconEl) btnIconEl.textContent = '🛵';
      sendBtn.disabled = false;
    }
  }

  if (!address || address.length < 3) {
    return showError('يرجى تحديد موقع السكن بالـ GPS أو كتابة العنوان بالتفصيل.');
  }

  // حفظ الموقع في بيانات العميل المسجلة باسم السكن
  state.customer = { name, phone, address, note, lat, lng, addressLabel: label };
  saveState();

  if (window.ACDPlatform) {
    ACDPlatform.auth.addCustomerSavedAddress({
      label: label || 'السكن',
      address,
      lat,
      lng
    });
  }

  if (window.ACDCloud && ACDCloud.user()) {
    try {
      ACDCloud.saveCustomerAddress({
        label: label || 'السكن',
        address,
        lat,
        lng,
        phone
      }).catch(() => {});
    } catch (_) {}
  }

  const waNum = (CONFIG.whatsapp || '201501805674').replace(/\D/g, '');
  const url = `https://wa.me/${waNum}?text=${encodeURIComponent(buildMessage(name, phone, address, note, lat, lng, label))}`;

  const orderInput = {
    customer: { name, phone, address, note, lat, lng, addressLabel: label },
    items: Object.entries(state.cart).map(([id,quantity])=>({id,name:byId.get(id).name,quantity,price:byId.get(id).price})),
    subtotal: subtotal(),
    deliveryFee: deliveryFee(),
    total: subtotal() + deliveryFee(),
    special: state.special,
    hasPharma: hasPharma()
  };

  let createdOrder = null;
  const cloudUser = window.ACDCloud?.user?.();
  if (cloudUser) {
    if (!cloudUser.emailVerified) {
      return showError('فعّل بريدك الإلكتروني أولاً من رابط التفعيل، ثم أرسل الطلب مرة أخرى. يمكنك إعادة إرسال الرابط من «حسابي».');
    }
    try {
      createdOrder = await ACDCloud.createOrder(orderInput);
    } catch (err) {
      return showError(ACDCloud.authError(err));
    }
  } else {
    // Guest checkout is intentionally WhatsApp-only. Production tracking/order history requires a verified account.
  }

  const orderMsg = createdOrder ? `تم تسجيل طلبك (${createdOrder.reference || createdOrder.id}) وحفظ موقع ${label} بنجاح!` : 'تم تجهيز الطلب وتحديد الموقع';
  toast(orderMsg + ' — لوكيشن الخريطة مرفق للمندوب Location');
  const w = window.open(url, '_blank');
  if (!w || w.closed || typeof w.closed === 'undefined') {
    window.location.href = url;
  }
}

/* ================== منطق حساب العميل وتحديد الموقع بالـ GPS والإشعارات ================== */
function detectDeviceLocation(onSuccess, onError) {
  getDeviceGpsCoords()
    .then(res => onSuccess(res))
    .catch(err => onError(err.message || 'تعذر الحصول على الموقع'));
}

// Bind address chips
function initAddrChips(containerSelector, onSelect) {
  const container = $(containerSelector);
  if (!container) return;
  container.addEventListener('click', e => {
    const chip = e.target.closest('.addr-chip');
    if (!chip) return;
    container.querySelectorAll('.addr-chip').forEach(c => c.classList.remove('selected'));
    chip.classList.add('selected');
    const label = chip.dataset.label;
    if (onSelect) onSelect(label);
  });
}

initAddrChips('#cartAddrTags', lbl => {
  currentAddressLabel = lbl;
  const labelDisplay = $('#cartCurrentLabelDisplay');
  if (labelDisplay) {
    const icon = lbl === 'السكن' ? '🏠 ' : (lbl === 'العمل' ? '💼 ' : '🎓 ');
    labelDisplay.textContent = icon + lbl;
  }
  const statusEl = $('#cartGpsStatus');
  if (statusEl && !currentGpsCoords) {
    statusEl.textContent = `⚡ جاهز: هيتم التقاط موقعك وتحديده كـ «${lbl}» أول ما تضغط على زر الطلب تحت!`;
  }
});
initAddrChips('#profileAddrTags', lbl => { currentAddressLabel = lbl; });

// Location Mode Toggle Event (GPS at order time vs Manual)
const locGpsRadio = $('#locTypeGps');
const locManualRadio = $('#locTypeManual');
const manualAddrWrap = $('#manualAddressWrapper');
const lblGpsOpt = $('#lblGpsOption');
const lblManualOpt = $('#lblManualOption');

if (locGpsRadio && locManualRadio) {
  locGpsRadio.addEventListener('change', () => {
    if (locGpsRadio.checked) {
      if (manualAddrWrap) manualAddrWrap.style.display = 'none';
      if (lblGpsOpt) { lblGpsOpt.style.borderColor = '#16a34a'; lblGpsOpt.style.color = '#166534'; lblGpsOpt.style.background = '#fff'; }
      if (lblManualOpt) { lblManualOpt.style.borderColor = '#d1d5db'; lblManualOpt.style.color = 'var(--muted)'; lblManualOpt.style.background = '#f9fafb'; }
      $('#cartGpsStatus').textContent = `⚡ جاهز: هيتم التقاط موقعك وتحديده كـ «${currentAddressLabel}» أول ما تضغط على زر الطلب تحت!`;
      if ($('#sendOrderBtnText')) $('#sendOrderBtnText').textContent = 'تحديد موقعي (GPS) وإرسال الطلب الآن';
    }
  });

  locManualRadio.addEventListener('change', () => {
    if (locManualRadio.checked) {
      if (manualAddrWrap) manualAddrWrap.style.display = 'block';
      if (lblManualOpt) { lblManualOpt.style.borderColor = '#16a34a'; lblManualOpt.style.color = '#166534'; lblManualOpt.style.background = '#fff'; }
      if (lblGpsOpt) { lblGpsOpt.style.borderColor = '#d1d5db'; lblGpsOpt.style.color = 'var(--muted)'; lblGpsOpt.style.background = '#f9fafb'; }
      $('#cartGpsStatus').textContent = '✍️ يمكنك كتابة تفاصيل الشارع والعمارة يدوياً في الخانة أدناه.';
      if ($('#sendOrderBtnText')) $('#sendOrderBtnText').textContent = 'إرسال الطلب على واتساب';
    }
  });
}

// Cart GPS Button
const btnCartGps = $('#btnCartDetectGps');
if (btnCartGps) {
  btnCartGps.addEventListener('click', () => {
    btnCartGps.disabled = true;
    $('#cartGpsStatus').textContent = '⏳ جاري تحديد موقعك بالقمر الصناعي...';
    detectDeviceLocation(
      res => {
        btnCartGps.disabled = false;
        $('#cartGpsStatus').textContent = `✅ تم التقاط الموقع بنجاح: ${res.address}`;
        $('#clientLocation').value = res.address;
        state.customer.address = res.address;
        state.customer.lat = res.lat;
        state.customer.lng = res.lng;
        state.customer.addressLabel = currentAddressLabel;
        saveState();
        toast(`Location تم تحديد موقعك (${currentAddressLabel}) بدقة عبر GPS`);

        // If user logged in, save to profile
        if (window.ACDPlatform) {
          ACDPlatform.auth.addCustomerSavedAddress({
            label: currentAddressLabel,
            address: res.address,
            lat: res.lat,
            lng: res.lng
          });
        }
      },
      err => {
        btnCartGps.disabled = false;
        $('#cartGpsStatus').textContent = `⚠️ ${err}`;
      }
    );
  });
}

// Profile GPS Button
