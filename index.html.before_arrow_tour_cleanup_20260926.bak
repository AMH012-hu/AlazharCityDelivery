});

/* ================== الأحداث ================== */
document.addEventListener('click', e => {
  const act = e.target.closest('[data-act]');
  if (act){
    const id = act.dataset.id;
    switch (act.dataset.act){
      case 'inc': setQty(id, (state.cart[id]||0)+1); break;
      case 'dec': setQty(id, (state.cart[id]||0)-1); break;
      case 'remove': setQty(id, 0); break;
      case 'edit-special': openSpecial(); break;
      case 'clear-special': state.special=''; saveState(); renderCart(); break;
    }
    return;
  }
  const cat = e.target.closest('[data-cat]');
  if (cat){ setCat(state.cat === cat.dataset.cat && cat.classList.contains('tile') ? 'all' : cat.dataset.cat); return; }
  const tab = e.target.closest('.tab'); if (tab){ setGroup(tab.dataset.group); return; }
  const cta = e.target.closest('[data-slide]'); if (cta){ goBanner(+cta.dataset.slide); return; }
  const dot = e.target.closest('[data-dot]'); if (dot){ showSlide(+dot.dataset.dot); startSlides(); return; }
  if (e.target.closest('[data-close]') || e.target.id === 'overlay') closeAll();
});

$('#openCart').addEventListener('click', () => openPanel('cartPanel'));
$('#cartBar').addEventListener('click', () => openPanel('cartPanel'));
$('#openHelp').addEventListener('click', () => openPanel('helpPanel'));
$('#openSpecial').addEventListener('click', openSpecial);
$('#addSpecialBtn').addEventListener('click', openSpecial);
$('#sendOrder').addEventListener('click', sendOrder);
$('#clearCart').addEventListener('click', () => {
  if (!hasOrder() || !confirm('تفريغ السلة بالكامل؟')) return;
  const ids = Object.keys(state.cart); state.cart = {}; state.special = '';
  saveState(); ids.forEach(refreshCards); renderCart();
});
$('#saveSpecial').addEventListener('click', () => {
  const txt = $('#specialText').value.trim();
  const bm = boycottMatch(txt);
  if (bm){ $('#specialErr').textContent = `🕊️ آسفين، «${bm.group}» من الشركات المقاطعة ومش بنوفّرها ولا بنوصّلها. شيلها من الطلب أو اطلب بديل.`; return; }
  $('#specialErr').textContent = '';
  state.special = txt; saveState(); renderCart(); closeAll();
  toast(state.special ? 'تم حفظ الطلب الخاص في السلة' : 'تم حذف الطلب الخاص');
});
$('#specialText').addEventListener('input', updateSpecialCount);

let searchTimer;
$('#search').addEventListener('input', e => { clearTimeout(searchTimer); searchTimer = setTimeout(() => { state.query = e.target.value; renderContent(); }, 150); });
$('#clearSearch').addEventListener('click', () => { $('#search').value=''; state.query=''; renderContent(); $('#search').focus(); });

[['#clientName','name'],['#clientPhone','phone'],['#clientLocation','address'],['#clientNote','note']].forEach(([s,k]) => $(s).addEventListener('input', e => { state.customer[k] = e.target.value; saveState(); }));

// سحب البانر باللمس
(() => {
  const h = $('#hero'); let x0 = null;
  h.addEventListener('touchstart', e => { x0 = e.touches[0].clientX; clearInterval(slideTimer); }, {passive:true});
  h.addEventListener('touchend', e => { if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) showSlide(slideIdx + (dx > 0 ? 1 : -1)); x0 = null; startSlides(); });
})();

document.addEventListener('error', e => { if (e.target.tagName === 'IMG' && e.target.closest('.pic')) e.target.remove(); }, true);
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAll(); });



/* ================== كتالوج وإعدادات Firebase ================== */
function renderFeaturedOffers(){
  const row = $('#featuredOffersRow');
  if(!row) return;
  const deals = PRODUCTS.filter(p => visible(p) && p.oldPrice && p.oldPrice > p.price);
  const productCards = deals.slice(0,10).map(cardHTML).join('');
  const infoCards = remoteOffers.map(o => `<article class="card offer-card"><div class="offer-head"><span class="offer-badge">${esc(o.tag||'عرض اليوم')}</span></div><h3 class="offer-title">${esc(o.title||'')}</h3><p class="offer-desc">${esc(o.desc||'')}</p></article>`).join('');
  row.innerHTML = (productCards + infoCards) || `<div class="empty">العروض بتتحدث أول بأول. ارجع بعد شوية وهتلاقي الجديد.</div>`;
}

async function loadRemoteSiteData(){
  if(!window.ACDCloud) return;
  try{
    const settings = await ACDCloud.getSiteSettings();
    if(settings && Object.keys(settings).length){
      CONFIG = {...CONFIG, ...settings};
      $('#areaName').textContent = CONFIG.area;
      $('#areaFixed').textContent = 'التوصيل إلى: ' + CONFIG.area;
      $('#footArea').textContent = CONFIG.area;
      $('#eta').textContent = CONFIG.eta;
      $('#audience').textContent = 'توصيل ' + CONFIG.audience + ' إلى';
      $('#hours').textContent = hh(CONFIG.openHour) + ' – ' + hh(CONFIG.closeHour);
      renderStatus();
    }
    const remote = await ACDCloud.getPublicCatalog();
    if(Array.isArray(remote) && remote.length){
      const merged = new Map(PRODUCTS.map(p=>[String(p.id), p]));
      remote.forEach((p,i)=>{ const id=String(p.id||p.productId||('product-'+i)); if(p.active===false){ merged.delete(id); } else if(CATEGORIES.some(c=>c[0]===p.cat)){ merged.set(id,{...p,id,price:Number(p.price||0),emoji:p.emoji||'🛍️'}); }});
      PRODUCTS = Array.from(merged.values());
      byId = new Map(PRODUCTS.map(p=>[p.id,p]));
      renderTiles(); renderContent(); renderCart();
    }
    remoteOffers = await ACDCloud.getPublicOffers();
    renderFeaturedOffers();
  }catch(err){
    console.warn('Remote catalog unavailable; local catalog remains active.', err?.code || err);
    renderFeaturedOffers();
  }
}
window.addEventListener('acd-cloud-ready', loadRemoteSiteData);

/* ================== جولة أول تشغيل ================== */
const INTRO_KEY = CONFIG.storageKey + '-first-launch-v2';
const PWA_INSTALLED_KEY = CONFIG.storageKey + '-pwa-installed-v2';
let introIndex = 0;
const introPages = () => $$('.intro-page');
function isPwaInstalled(){ try{return isStandalone() || localStorage.getItem(PWA_INSTALLED_KEY)==='1';}catch(_){return isStandalone();} }
function markPwaInstalled(){try{localStorage.setItem(PWA_INSTALLED_KEY,'1');localStorage.setItem(INTRO_KEY,'1');}catch(_){}}
function applyInstalledState(){if(!isPwaInstalled())return;$('#installBox')?.classList.remove('show');$('#topInstallBtn')?.setAttribute('hidden','hidden');$('#palBanner')?.setAttribute('hidden','hidden');}
window.addEventListener('appinstalled',()=>{markPwaInstalled();applyInstalledState();closeIntro(true);});
function renderIntro(dir){const pages=introPages();pages.forEach((p,i)=>{if(i===introIndex){p.dataset.dir=dir||'fwd';p.classList.remove('active');void p.offsetWidth;p.classList.add('active');}else{p.classList.remove('active');delete p.dataset.dir;}});$$('#introProgress i').forEach((d,i)=>{d.classList.toggle('active',i<=introIndex);d.classList.toggle('current',i===introIndex);});$('#introPrev').hidden=introIndex===0;$('#introNext').textContent=introIndex===pages.length-1?'نزّل التطبيق':'التالي';}
function openIntro(){if(isPwaInstalled())return;try{if(localStorage.getItem(INTRO_KEY)==='1')return;}catch(_){}introIndex=0;renderIntro('fwd');$('#firstLaunchIntro').classList.add('open');document.body.classList.add('lock');}
function closeIntro(markDone=false){if(markDone){try{localStorage.setItem(INTRO_KEY,'1')}catch(_){}}$('#firstLaunchIntro').classList.remove('open');document.body.classList.remove('lock');}
$('#introPrev')?.addEventListener('click',()=>{if(introIndex>0){introIndex--;renderIntro('back');}});
$('#introNext')?.addEventListener('click',async()=>{if(introIndex<introPages().length-1){introIndex++;renderIntro('fwd');return;}try{closeIntro(false);await handleInstallAction();}catch(_){}});
$('#introSkip')?.addEventListener('click',()=>closeIntro(true));
$('#firstLaunchIntro')?.addEventListener('click',e=>{if(e.target.id==='firstLaunchIntro')closeIntro(true);});
let introX0=null;$('#firstLaunchIntro')?.addEventListener('touchstart',e=>{introX0=e.touches[0].clientX},{passive:true});$('#firstLaunchIntro')?.addEventListener('touchend',e=>{if(introX0===null)return;const dx=e.changedTouches[0].clientX-introX0;introX0=null;if(Math.abs(dx)<45)return;if(dx<0&&introIndex<introPages().length-1){introIndex++;renderIntro('fwd');}else if(dx>0&&introIndex>0){introIndex--;renderIntro('back');}});


/* ================== Dynamic Scroll Tour ================== */
(function initDynamicScrollTour(){

  const TOUR_KEY = CONFIG.storageKey + '-scroll-tour-v1';

  const tour = document.getElementById('scrollTour');
  const card = document.getElementById('scrollTourCard');
  const arrow = document.getElementById('scrollTourArrow');
  const icon = document.getElementById('scrollTourIcon');
  const title = document.getElementById('scrollTourTitle');
  const text = document.getElementById('scrollTourText');
  const progress = document.getElementById('scrollTourProgress');
  const close = document.getElementById('scrollTourClose');

  if(!tour || !card || !arrow) return;

  /*
   * كل مرحلة مرتبطة بجزء حقيقي موجود في الموقع.
   * المرحلة تظهر أثناء الـ scroll وتوجه المستخدم للعنصر.
   */
  const steps = [
    {
      target:'#openAccountBtn',
      icon:'👤',
      title:'1 — اعمل حسابك',
      text:'من هنا تقدر تعمل حسابك، تضيف بياناتك وعناوينك، وتخلي الطلبات الجاية أسرع.',
      minScroll:80,
      arrow:'↑'
    },
    {
      target:'#catSec',
      icon:'🛍️',
      title:'2 — اختار اللي محتاجه',
      text:'انزل هنا واختار القسم اللي محتاجه، وبعدها اختار المنتجات وأضفها للسلة.',
      minScroll:260,
      arrow:'↓'
    },
    {
      target:'#openCart',
      icon:'🛒',
      title:'3 — راجع السلة',
      text:'بعد ما تخلص اختيارك افتح السلة من هنا، راجع المنتجات والكميات والإجمالي قبل إتمام الطلب.',
      minScroll:700,
      arrow:'↑'
    },
    {
      target:'#openAccountBtn',
      icon:'Location',
      title:'4 — حدد مكان التوصيل',
      text:'من حسابك تقدر تضيف عنوان السكن أو تستخدم تحديد الموقع GPS علشان المندوب يعرف مكان التسليم.',
      minScroll:1000,
      arrow:'↑'
    },
    {
      target:'a[href="./track.html"]',
      icon:'📦',
      title:'5 — تابع طلبك',
      text:'بعد الطلب، استخدم متابعة الطلب علشان تعرف حالة طلبك وتفاصيله لحد الاستلام.',
      minScroll:1300,
      arrow:'↓'
    }
  ];

  let currentStep = -1;
  let running = false;
  let scrollTimer = null;

  function alreadySeen(){
    try{
      return localStorage.getItem(TOUR_KEY) === '1';
    }catch(_){
      return false;
    }
  }

  function markSeen(){
    try{
      localStorage.setItem(TOUR_KEY,'1');
    }catch(_){}
  }

  function clearTarget(){
    document.querySelectorAll('.scroll-tour-target').forEach(el=>{
      el.classList.remove('scroll-tour-target');
    });
  }

  function getTarget(step){
    if(!step) return null;

    /*
     * track.html ممكن يكون موجود أكتر من مرة في الصفحة.
     * نختار أول عنصر ظاهر.
     */
    const all = document.querySelectorAll(step.target);

    for(const el of all){
      const r = el.getBoundingClientRect();
      if(r.width && r.height) return el;
    }

    return all[0] || null;
  }

  function positionArrow(target, step){
    if(!target){
      arrow.classList.remove('show');
      return;
    }

    const r = target.getBoundingClientRect();

    let x = r.left + r.width / 2 - 24;
    let y;

    if(step.arrow === '↑'){
      y = Math.max(12, r.top - 62);
    }else{
      y = Math.min(window.innerHeight - 58, r.bottom + 14);
    }

    x = Math.max(10, Math.min(window.innerWidth - 58, x));

    arrow.style.left = x + 'px';
    arrow.style.top = y + 'px';
    arrow.textContent = step.arrow;

    requestAnimationFrame(()=>{
      arrow.classList.add('show');
    });
  }

  function positionCard(target){
    if(window.innerWidth <= 520){
      card.style.left = '';
      card.style.top = '';
      return;
    }

    const r = target?.getBoundingClientRect();

    if(!r){
      card.style.left = '50%';
      card.style.top = '50%';
      card.style.transform = 'translate(-50%,-50%)';
      return;
    }

    card.style.transform = '';
    
    let left = r.left + r.width / 2 - 165;
    let top = r.bottom + 18;

    if(top + 170 > window.innerHeight){
      top = r.top - 190;
    }

    left = Math.max(14, Math.min(window.innerWidth - 344, left));
    top = Math.max(14, Math.min(window.innerHeight - 190, top));

    card.style.left = left + 'px';
    card.style.top = top + 'px';
  }

  function renderProgress(index){
    [...progress.children].forEach((dot,i)=>{
      dot.classList.toggle('active', i === index);
    });
  }

  function showStep(index){
    if(index < 0 || index >= steps.length) return;

    const step = steps[index];
    const target = getTarget(step);

    if(!target) return;

    clearTarget();

    currentStep = index;
    running = true;

    target.classList.add('scroll-tour-target');

    icon.textContent = step.icon;
    title.textContent = step.title;
    text.textContent = step.text;

    renderProgress(index);

    tour.classList.add('active');
    tour.setAttribute('aria-hidden','false');

    positionArrow(target,step);
    positionCard(target);

    requestAnimationFrame(()=>{
      card.classList.add('show');
    });
  }

  function hideTour(mark=true){
    clearTarget();
    card.classList.remove('show');
    arrow.classList.remove('show');
    tour.classList.remove('active');
    tour.setAttribute('aria-hidden','true');
    running = false;

    if(mark) markSeen();
  }

  function calculateStep(){
    const y = window.scrollY || window.pageYOffset || 0;

    /*
     * نستخدم نقاط scroll تدريجية.
     * المستخدم مش محتاج يضغط Next؛ الـ scroll نفسه هو الـ navigation.
     */
    let index = 0;

    for(let i=0;i<steps.length;i++){
      if(y >= steps[i].minScroll) index = i;
    }

    return index;
  }

  function handleScroll(){
    if(alreadySeen()) return;

    /*
     * بداية الجولة أول ما المستخدم يبدأ يتحرك.
     */
    if(!running && window.scrollY > 25){
      showStep(0);
      return;
    }

    if(!running) return;

    clearTimeout(scrollTimer);

    scrollTimer = setTimeout(()=>{
      const next = calculateStep();

      if(next !== currentStep){
        showStep(next);
      }else{
        const step = steps[currentStep];
        const target = getTarget(step);

        if(target){
          positionArrow(target,step);
          positionCard(target);
        }
      }
    },45);
  }

  close?.addEventListener('click',()=>{
    hideTour(true);
  });

  /*
   * لو المستخدم ضغط خارج الكارت، نعتبر إنه مش محتاج الجولة.
   */
  document.querySelector('.scroll-tour-dim')?.addEventListener('click',()=>{
    hideTour(true);
  });

  /*
   * لما يوصل لآخر خطوة ونزل شوية زيادة:
   * نختم الجولة.
   */
  window.addEventListener('scroll',()=>{
    handleScroll();

    if(running && currentStep === steps.length-1){
      const max =
        document.documentElement.scrollHeight - window.innerHeight;

      if(max > 0 && window.scrollY > max - 120){
        hideTour(true);
      }
    }
  },{passive:true});

  window.addEventListener('resize',()=>{
    if(!running) return;

    const step = steps[currentStep];
    const target = getTarget(step);

    if(target){
      positionArrow(target,step);
      positionCard(target);
    }
  });

  /*
   * بداية خفيفة:
   * المستخدم يشوف أول رسالة من غير ما نوقف الصفحة.
   */
  setTimeout(()=>{
    if(!alreadySeen() && window.scrollY < 25){
      const first = steps[0];
      const target = getTarget(first);

      if(target){
        currentStep = 0;
        running = true;

        target.classList.add('scroll-tour-target');

        icon.textContent = first.icon;
        title.textContent = first.title;
        text.textContent = 'ابدأ بالنزول شوية، وأنا هشرحلك الموقع خطوة بخطوة 👇';

        renderProgress(0);

        tour.classList.add('active');
        tour.setAttribute('aria-hidden','false');

        positionArrow(target,first);
        positionCard(target);

        requestAnimationFrame(()=>{
          card.classList.add('show');
        });
      }
    }
  },1800);

})();


/* ================== تثبيت التطبيق (PWA) ================== */
let deferredPrompt = null;
const isStandalone = () => matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
const isIOS = () => /iphone|ipad|ipod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
const installDismissed = () => { try { return Date.now() - Number(localStorage.getItem(CONFIG.storageKey + '-install-x') || 0) < 7*864e5; } catch(e){ return false; } };

function showInstall(){
  if (isPwaInstalled() || installDismissed()) return;
  $('#installBox').classList.add('show');
}
window.addEventListener('beforeinstallprompt', e => { e.preventDefault(); deferredPrompt = e; showInstall(); });
window.addEventListener('appinstalled', () => { deferredPrompt = null; markPwaInstalled(); $('#installBox').classList.remove('show'); $('#topInstallBtn')?.setAttribute('hidden','hidden'); closeIntro(true); toast('تم تثبيت التطبيق ✅'); });

async function handleInstallAction(){
  if (deferredPrompt){
    deferredPrompt.prompt();
    const { outcome } = await deferredPrompt.userChoice;
    deferredPrompt = null;
    if (outcome === 'accepted'){
      $('#installBox').classList.remove('show');
      toast('تم تثبيت التطبيق بنجاح ✅');
    }
    return;
  }
  // خطوات التثبيت اليدوي (أندرويد / آيفون / كمبيوتر)
  $('#installSteps').innerHTML = isIOS()
    ? '<li>افتح الموقع في متصفح <b>Safari</b>.</li><li>اضغط على زرار المشاركة <b>⬆️</b> أسفل الشاشة.</li><li>اختر <b>«إضافة إلى الشاشة الرئيسية» (Add to Home Screen)</b>.</li><li>اضغط <b>إضافة</b> وستظهر أيقونة التطبيق على شاشة موبايلك.</li>'
    : '<li>اضغط على قائمة المتصفح (الثلاث نقاط <b>⋮</b> أعلى اليسار/اليمين).</li><li>اختر <b>«تثبيت التطبيق» (Install app)</b> أو <b>«إضافة إلى الشاشة الرئيسية»</b>.</li><li>أكّد التثبيت وستنزل أيقونة التطبيق على جهازك فورًا كأي تطبيق أندرويد.</li>';
  openPanel('installPanel');
}

$('#installBtn').addEventListener('click', handleInstallAction);
const topBtn = $('#topInstallBtn');
if (topBtn) topBtn.addEventListener('click', handleInstallAction);
$('#installClose').addEventListener('click', () => {
  $('#installBox').classList.remove('show');
  try { localStorage.setItem(CONFIG.storageKey + '-install-x', String(Date.now())); } catch(e){}
});
// عرض بانر التثبيت إذا لم يكن مثبتاً بالفعل
showInstall();
if (isPwaInstalled()) $('#topInstallBtn')?.setAttribute('hidden','hidden');
setTimeout(openIntro, 250);

if ('serviceWorker' in navigator && location.protocol.startsWith('http')){
  window.addEventListener('load', () => navigator.serviceWorker.register('./sw.js').catch(() => {}));
}

/* ================== تشغيل ================== */
loadState();
$('#areaName').textContent = CONFIG.area;
$('#areaFixed').textContent = 'التوصيل إلى: ' + CONFIG.area;
$('#footArea').textContent = CONFIG.area;
$('#brandName').textContent = CONFIG.brand;
$('#eta').textContent = CONFIG.eta;
$('#hours').textContent = hh(CONFIG.openHour) + ' – ' + hh(CONFIG.closeHour);
$('#audience').textContent = 'توصيل ' + CONFIG.audience + ' إلى';
$('#clientName').value = state.customer.name;
$('#clientPhone').value = state.customer.phone;
$('#clientLocation').value = state.customer.address;
$('#clientNote').value = state.customer.note;
renderStatus(); setInterval(renderStatus, 60000);
renderHero(); renderTiles(); renderContent(); renderCart(); renderFeaturedOffers();
</script>
<script src="./customer-flow.js?v=20260924"></script>

<!-- دليل تفاعلي منبثق -->
