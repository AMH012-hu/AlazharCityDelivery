// Save Address to Profile
const btnSaveAddr = $('#btnSaveAddressToProfile');
if (btnSaveAddr) {
  btnSaveAddr.addEventListener('click', async () => {
    const val = $('#profileDetailedAddr').value.trim();
    if (val.length < 3) return toast('يرجى كتابة أو تحديد العنوان أولاً');
    if (window.ACDCloud?.saveCustomerAddress) {
      try {
        await ACDCloud.saveCustomerAddress({
          label: currentAddressLabel,
          address: val,
          lat: currentGpsCoords?.lat || null,
          lng: currentGpsCoords?.lng || null
        });
        toast(`✅ تم حفظ «${currentAddressLabel}» في حسابك بنجاح!`);
        renderCustomerAuthUI();
      } catch (err) {
        toast(ACDCloud.authError(err));
      }
    }
  });
}

// Render Customer Auth UI (Firebase is the only production account authority)
function authUserView() {
  const fbUser = window.ACDCloud?.user?.();
  const profile = window.ACDCloud?.profile?.();
  if (!fbUser || !profile) return null;
  return { user: fbUser, profile };
}

function renderCustomerAuthUI() {
  const account = authUserView();
  const loggedInBox = $('#accountLoggedIn');
  const loggedOutBox = $('#accountLoggedOut');
  const userIcon = $('#userIcon');

  if (account) {
    const { user, profile } = account;
    loggedInBox.style.display = 'block';
    loggedOutBox.style.display = 'none';
    $('#custProfileName').textContent = profile.name || user.displayName || 'عميل الأزهر';
    $('#custProfileEmail').textContent = profile.email || user.email || '';
    $('#custProfilePhone').textContent = profile.phone || 'لم تتم إضافة رقم موبايل';
    if (userIcon) { userIcon.style.color = profile.emailVerified ? 'var(--green)' : 'var(--brand)'; userIcon.setAttribute('aria-label', profile.emailVerified ? 'الحساب مفعل' : 'الحساب يحتاج تفعيل البريد'); }

    const verifyBox = $('#emailVerificationBox');
    if (verifyBox) verifyBox.style.display = user.emailVerified ? 'none' : 'block';

    if (!$('#clientName').value && profile.name) $('#clientName').value = profile.name;
    if (!$('#clientPhone').value && profile.phone) $('#clientPhone').value = profile.phone;
    const nameEdit = $('#accountNameEdit'); const phoneEdit = $('#accountPhoneEdit');
    if (nameEdit) nameEdit.value = profile.name || user.displayName || '';
    if (phoneEdit) phoneEdit.value = profile.phone || user.phoneNumber || '';
    const roleLabel = profile.role === 'admin' ? 'إدارة' : profile.role === 'store' ? 'متجر' : profile.role === 'rider' ? 'مندوب' : 'عميل';
    if ($('#custRoleBadge')) $('#custRoleBadge').textContent = roleLabel;
    const displayName = profile.name || user.displayName || 'عميل الأزهر';
    if ($('#custProfileAvatar')) $('#custProfileAvatar').textContent = (displayName.trim().charAt(0) || 'A').toUpperCase();
    const photo = $('#custProfilePhoto'); const avatar = $('#custProfileAvatar');
    if (photo) { if (profile.photoURL) { photo.src = profile.photoURL; photo.style.display='block'; if (avatar) avatar.style.display='none'; } else { photo.style.display='none'; if (avatar) avatar.style.display='grid'; } }
    const providers = Array.isArray(user.providerData) ? user.providerData.map(p => p.providerId) : [];
    if ($('#btnLinkGoogle')) $('#btnLinkGoogle').style.display = providers.includes('google.com') ? 'none' : 'flex';
    if ($('#portalShortcut')) $('#portalShortcut').style.display = ['admin','store','rider'].includes(profile.role) ? 'flex' : 'none';

    const addresses = Array.isArray(profile.savedAddresses) ? profile.savedAddresses : [];
    const listEl = $('#savedAddressesList');
    if (listEl) {
      if (!addresses.length) {
        listEl.innerHTML = '<div style="font-size:0.8rem;color:var(--muted);padding:8px">لا توجد عناوين محفوظة بعد.</div>';
      } else {
        listEl.innerHTML = addresses.map(a => `
          <div class="saved-addr-card" data-addr="${esc(a.address || '')}" data-label="${esc(a.label || 'السكن')}">
            <div>
              <b style="color:var(--brand-d)">${a.label === 'السكن' ? '🏠' : (a.label === 'العمل' ? '💼' : '🎓')} ${esc(a.label || 'السكن')}</b>
              <div style="font-size:0.75rem;color:var(--muted);margin-top:2px">${esc(a.address || 'موقع GPS محفوظ')}</div>
            </div>
            <button type="button" class="btn-act" style="background:var(--brand);color:#fff;border:0;border-radius:8px;padding:5px 10px;font-size:0.75rem;font-weight:700">اختيار</button>
          </div>
        `).join('');
      }
    }
  } else {
    loggedInBox.style.display = 'none';
    loggedOutBox.style.display = 'block';
    if (userIcon) { userIcon.style.color = ''; userIcon.setAttribute('aria-label','تسجيل الدخول أو حسابي'); }
  }
}

// Select saved address from card
document.addEventListener('click', e => {
  const card = e.target.closest('.saved-addr-card');
  if (!card) return;
  const addr = card.dataset.addr || '';
  const label = card.dataset.label || 'السكن';
  $('#clientLocation').value = addr;
  state.customer.address = addr;
  state.customer.addressLabel = label;
  saveState();
  toast(`تم تطبيق عنوان «${label}» في سلة الشراء بنجاح!`);
  closeAll();
});

function setAuthBusy(formId, busy, label) {
  const form = document.getElementById(formId);
  const btn = form?.querySelector('button[type="submit"]');
  if (!btn) return;
  btn.disabled = busy;
  if (!btn.dataset.label) btn.dataset.label = btn.textContent;
  btn.textContent = busy ? label : btn.dataset.label;
}

// Auth Tabs switch
$('#tabCustomerRegister').addEventListener('click', () => {
  $('#tabCustomerRegister').classList.add('active'); $('#tabCustomerRegister').setAttribute('aria-selected','true');
  $('#tabCustomerLogin').setAttribute('aria-selected','false');
  $('#tabCustomerLogin').classList.remove('active');
  $('#custRegisterForm').style.display = 'block';
  $('#custLoginForm').style.display = 'none';
});
$('#tabCustomerLogin').addEventListener('click', () => {
  $('#tabCustomerLogin').classList.add('active'); $('#tabCustomerLogin').setAttribute('aria-selected','true');
  $('#tabCustomerRegister').setAttribute('aria-selected','false');
  $('#tabCustomerRegister').classList.remove('active');
  $('#custLoginForm').style.display = 'block';
  $('#custRegisterForm').style.display = 'none';
});

// Account form UX
document.querySelectorAll('[data-toggle-password]').forEach(btn => btn.addEventListener('click', () => { const input = document.getElementById(btn.dataset.togglePassword); if (!input) return; const visible = input.type === 'text'; input.type = visible ? 'password' : 'text'; btn.textContent = visible ? 'إظهار' : 'إخفاء'; }));
function updatePasswordStrength(password){ const meter=$('#passwordMeter'); if(!meter) return; const score=[password.length>=8,/[A-Za-z]/.test(password),/\d/.test(password),/[^A-Za-z\d]/.test(password)].filter(Boolean).length; [...meter.children].forEach((el,i)=>el.classList.toggle('on',i<score)); const h=$('#passwordHint'); if(h) h.textContent=score<=1?'ضعيفة — استخدم 8 خانات على الأقل مع حروف وأرقام.':score===2?'مقبولة — إضافة رقم ورمز تخليها أقوى.':score===3?'جيدة — باقي خطوة صغيرة.':'قوية — ممتاز.'; }
$('#regPassword')?.addEventListener('input', e => updatePasswordStrength(e.target.value));

// Customer Registration
$('#custRegisterForm').addEventListener('submit', async e => {
  e.preventDefault();
  const name = $('#regName').value.trim();
  const email = $('#regEmail').value.trim().toLowerCase();
  const phone = $('#regPhone').value.trim();
  const password = $('#regPassword').value;
  const confirmPassword = $('#regPasswordConfirm').value;
  const address = $('#regAddress').value.trim();
  const errEl = $('#regError');
  errEl.textContent = '';

  if (name.length < 3) return errEl.textContent = 'يرجى كتابة الاسم بالكامل.';
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return errEl.textContent = 'اكتب بريدًا إلكترونيًا صحيحًا.';
  const normalizedPhone = phone.replace(/[\s-]/g, '').replace(/\D/g, '');
  if (!/^01[0125]\d{8}$/.test(normalizedPhone)) return errEl.textContent = 'رقم الموبايل غير صحيح (مثال: 01012345678).';
  if (password.length < 8) return errEl.textContent = 'كلمة المرور يجب أن تكون 8 خانات على الأقل.';
  if (password !== confirmPassword) return errEl.textContent = 'تأكيد كلمة المرور غير مطابق.';

  if (!window.ACDCloud?.signUpWithEmail) {
    errEl.textContent = 'خدمة الحساب غير جاهزة. أعد تحميل الصفحة وحاول مرة أخرى.';
    return;
  }

  setAuthBusy('custRegisterForm', true, 'جارٍ إنشاء الحساب...');
  try {
    const res = await ACDCloud.signUpWithEmail(email, password, name, normalizedPhone, {
      label: currentAddressLabel || 'السكن',
      address,
      lat: currentGpsCoords?.lat,
      lng: currentGpsCoords?.lng
    });
    toast(`مرحباً بك يا ${name}! تم إنشاء الحساب. راجع بريدك الإلكتروني لتفعيل الحساب ✉️`);
    renderCustomerAuthUI();
  } catch (err) {
    errEl.textContent = ACDCloud.authError(err);
  } finally {
    setAuthBusy('custRegisterForm', false);
  }
});

// Customer Login
$('#custLoginForm').addEventListener('submit', async e => {
  e.preventDefault();
  const email = $('#loginEmail').value.trim().toLowerCase();
  const password = $('#loginPassword').value;
  const errEl = $('#loginError');
  errEl.textContent = '';
  if (!window.ACDCloud?.signInWithEmail) return errEl.textContent = 'خدمة الحساب غير جاهزة. أعد تحميل الصفحة.';

  setAuthBusy('custLoginForm', true, 'جارٍ تسجيل الدخول...');
  try {
    const res = await ACDCloud.signInWithEmail(email, password);
    toast(`أهلاً بعودتك يا ${res.profile?.name || 'عميل الأزهر'}! 👋`);
    renderCustomerAuthUI();
  } catch (err) {
    errEl.textContent = ACDCloud.authError(err);
  } finally {
    setAuthBusy('custLoginForm', false);
  }
});

// Password reset
$('#btnResetPassword').addEventListener('click', async () => {
  const email = $('#loginEmail').value.trim().toLowerCase();
  const errEl = $('#loginError');
  if (!email) {
    errEl.textContent = 'اكتب بريدك الإلكتروني أولاً ثم اضغط «نسيت كلمة المرور؟».';
    return;
  }
  try {
    await ACDCloud.resetPassword(email);
    errEl.style.color = '#166534';
    errEl.textContent = 'تم إرسال رابط إعادة تعيين كلمة المرور إلى بريدك الإلكتروني.';
  } catch (err) {
    errEl.style.color = '';
    errEl.textContent = ACDCloud.authError(err);
  }
});

