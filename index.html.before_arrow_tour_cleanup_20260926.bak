// Account profile actions
$('#btnSaveAccountProfile')?.addEventListener('click', async () => { const errEl=$('#accountProfileError'); if(errEl) errEl.textContent=''; const name=$('#accountNameEdit')?.value.trim()||''; const phone=$('#accountPhoneEdit')?.value.trim()||''; if(name.length<3){ if(errEl) errEl.textContent='اكتب الاسم بالكامل علشان نستخدمه في الطلبات.'; return; } const btn=$('#btnSaveAccountProfile'); const old=btn?.textContent; if(btn){btn.disabled=true;btn.textContent='جارٍ حفظ البيانات...';} try{await ACDCloud.saveCustomerProfile({name,phone}); renderCustomerAuthUI(); toast('تم حفظ بيانات حسابك ✅');}catch(err){if(errEl) errEl.textContent=ACDCloud.authError(err);}finally{if(btn){btn.disabled=false;btn.textContent=old||'حفظ بيانات الحساب';}} });
$('#btnAccountRefreshClaims')?.addEventListener('click', async()=>{try{await ACDCloud.refreshClaims();renderCustomerAuthUI();toast('تم تحديث الجلسة والصلاحيات ✅')}catch(err){toast(ACDCloud.authError(err))}});
$('#btnLinkGoogle')?.addEventListener('click', async()=>{const btn=$('#btnLinkGoogle');try{if(btn)btn.disabled=true;const res=await ACDCloud.linkGoogleAccount();if(res?.redirecting)return;renderCustomerAuthUI();toast('تم ربط حساب Google بحسابك ✅')}catch(err){toast(ACDCloud.authError(err))}finally{if(btn)btn.disabled=false}});

// Google Login
$('#btnGoogleAuth').addEventListener('click', async () => {
  if (!window.ACDCloud?.signIn) return toast('جاري تجهيز تسجيل الدخول، جرّب بعد ثواني.');
  const btn=$('#btnGoogleAuth'); const old=btn.innerHTML; btn.disabled=true; btn.innerHTML='<span class="google-logo">G</span><span><b>جارٍ فتح Google…</b><small>ثواني ونرجعك للموقع</small></span><span class="auth-spinner"></span>';
  try { const res=await ACDCloud.signIn(); if(res?.redirecting) return; toast(`أهلاً بيك${res.user?.displayName ? ` يا ${res.user.displayName.split(' ')[0]}` : ''} 👋`); renderCustomerAuthUI(); } catch(err){ toast(ACDCloud.authError(err)); btn.disabled=false; btn.innerHTML=old; }
});
window.addEventListener('acd-auth-google-complete', () => { renderCustomerAuthUI(); toast('أهلاً بيك 👋 تم تسجيل الدخول بحساب Google.'); });
window.addEventListener('acd-auth-google-linked', () => { renderCustomerAuthUI(); toast('تم ربط حساب Google بحسابك بنجاح ✅'); });

window.addEventListener('acd-auth-change', () => renderCustomerAuthUI());
window.addEventListener('acd-auth-profile', () => renderCustomerAuthUI());

// V15 motion system: subtle reveal, no dependency, respects reduced motion.
(function initV15Motion(){
  const items=[...document.querySelectorAll('.v15-section-reveal')];
  if(!items.length) return;
  if(window.matchMedia?.('(prefers-reduced-motion: reduce)').matches){items.forEach(x=>x.classList.add('v15-visible'));return;}
  const io=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('v15-visible');io.unobserve(e.target)}}),{threshold:.12,rootMargin:'0px 0px -40px'});
  items.forEach(x=>io.observe(x));
})();


// Open Account Panel
$('#openAccountBtn').addEventListener('click', () => {
  const account = authUserView();
  if (!account) {
    const returnTo = encodeURIComponent(window.location.pathname.split('/').pop() || 'index.html');
    window.location.href = `./login.html?returnTo=${returnTo}`;
    return;
  }
  renderCustomerAuthUI();
  openPanel('accountPanel');
});

// Daily Offers & Notifications
function renderDailyOffers() {
  const container = $('#dailyOffersContainer');
  if (!container || !window.ACDPlatform) return;
  const list = remoteOffers.length ? remoteOffers : ACDPlatform.getOffers();
  container.innerHTML = list.map(o => `
    <div class="offer-card">
      <div class="offer-head">
        <span class="offer-badge">${esc(o.tag)}</span>
        <span style="font-size:0.75rem;color:var(--muted)">${esc(o.date)}</span>
      </div>
      <h3 class="offer-title">${esc(o.title)}</h3>
      <p class="offer-desc">${esc(o.desc)}</p>
    </div>
  `).join('');
}

$('#openNotificationsBtn').addEventListener('click', () => {
  renderDailyOffers();
  $('#notifBadge').style.display = 'none';
  openPanel('notificationsPanel');
});

